{
  "permissions": {
    "allow": [
      "Bash(ps -W)",
      "Bash(tasklist //FI \"IMAGENAME eq node.exe\")",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://localhost:3000)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" --max-time 5 http://localhost:3000)",
      "Bash(echo \"exit:$?\")",
      "Bash(timeout 5 bash -c 'exec 3<>/dev/tcp/127.0.0.1/3000 && echo \"connected\"')",
      "PowerShell(pnpm exec tsc --noEmit)"
    ]
  }
}
